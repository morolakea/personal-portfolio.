
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Morolake Ayo-Adebanjo's portfolio in product management, UX research, product design, and analytics.">
  <title>Morolake Ayo-Adebanjo | Product & UX Portfolio</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --pink: #e83e80;
      --deep-pink: #bc245e;
      --rose: #f7b3cd;
      --light-pink: #fde8f0;
      --pale-pink: #fff5f8;
      --ink: #211522;
      --muted: #746170;
      --white: #ffffff;
      --border: #f5d5e2;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      font-family: "DM Sans", sans-serif;
      background: var(--pale-pink);
      color: var(--ink);
      line-height: 1.65;
    }

    a { color: var(--deep-pink); }

    a:focus-visible {
      outline: 3px solid var(--pink);
      outline-offset: 4px;
    }

    .container {
      width: min(1120px, 90%);
      margin: auto;
    }

    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 22px 0;
    }

    .logo {
      font-family: "Manrope", sans-serif;
      font-size: 28px;
      font-weight: 800;
      color: var(--pink);
      text-decoration: none;
      letter-spacing: -2px;
    }

    .nav-links {
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
    }

    .nav-links a {
      color: var(--ink);
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    .nav-links a:hover { color: var(--pink); }

    .button {
      display: inline-block;
      padding: 12px 22px;
      background: var(--pink);
      color: var(--white);
      text-decoration: none;
      border-radius: 30px;
      font-size: 14px;
      font-weight: 700;
      transition: transform .2s, background .2s;
    }

    .button:hover {
      background: var(--deep-pink);
      color: white;
      transform: translateY(-2px);
    }

    .button-outline {
      background: white;
      color: var(--deep-pink);
      border: 1px solid var(--border);
    }

    .button-outline:hover { color: white; }

    .hero {
      display: grid;
      grid-template-columns: 1.2fr .8fr;
      align-items: center;
      gap: 45px;
      padding: 62px 0 55px;
    }

    .eyebrow {
      color: var(--pink);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 12px;
      font-weight: 800;
    }

    h1, h2, h3 {
      font-family: "Manrope", sans-serif;
      line-height: 1.15;
    }

    h1 {
      margin: 12px 0 16px;
      font-size: clamp(40px, 6vw, 68px);
      letter-spacing: -3.5px;
      overflow-wrap: anywhere;
    }

    .headline {
      color: var(--deep-pink);
      font-weight: 700;
      font-size: 14px;
      line-height: 1.9;
    }

    .intro {
      font-size: 16px;
      color: var(--muted);
      max-width: 620px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 25px;
    }

    .portrait-area {
      min-height: 330px;
      background: linear-gradient(145deg, #f7a8c7, #fde0eb 70%);
      border-radius: 48% 48% 35% 35%;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      padding: 30px;
    }

    .portrait-initials {
      width: 190px;
      height: 190px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: rgba(255,255,255,.55);
      border: 2px solid rgba(255,255,255,.8);
      color: var(--deep-pink);
      font-family: "Manrope", sans-serif;
      font-size: 76px;
      font-weight: 800;
      letter-spacing: -7px;
    }

    .portrait-note {
      position: absolute;
      bottom: 18px;
      right: -12px;
      background: white;
      padding: 12px 17px;
      border-radius: 15px;
      box-shadow: 0 8px 30px #8e31521a;
      font-size: 13px;
      font-weight: 700;
    }

    section { scroll-margin-top: 25px; }

    .info-strip {
      display: grid;
      grid-template-columns: 1.2fr .8fr 1fr;
      background: #fce3ed;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 25px;
      gap: 22px;
    }

    .info-item {
      display: flex;
      align-items: flex-start;
      gap: 13px;
    }

    .icon {
      flex-shrink: 0;
      width: 45px;
      height: 45px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: #f8c5d9;
      font-size: 20px;
    }

    .info-item strong { display: block; font-size: 14px; }
    .info-item p { margin: 4px 0 0; font-size: 12px; color: var(--muted); }

    .section-block { padding: 82px 0 0; }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 20px;
      margin-bottom: 25px;
    }

    h2 {
      font-size: clamp(30px, 4vw, 42px);
      letter-spacing: -1.7px;
      margin: 8px 0 0;
    }

    .section-description {
      max-width: 450px;
      font-size: 14px;
      color: var(--muted);
      margin: 0;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 14px;
    }

    .skill-card {
      padding: 23px 17px;
      background: white;
      border: 1px solid var(--border);
      border-radius: 20px;
      transition: transform .2s, box-shadow .2s;
    }

    .skill-card:hover, .project-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px #b82b6012;
    }

    .skill-card .icon { margin-bottom: 16px; }

    .skill-card h3 {
      font-size: 15px;
      margin: 0 0 9px;
      letter-spacing: -.4px;
    }

    .skill-card p {
      color: var(--muted);
      font-size: 12px;
      margin: 0;
    }

    .education-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 28px;
      display: flex;
      align-items: flex-start;
      gap: 22px;
    }

    .school-logo {
      width: 75px;
      height: 75px;
      object-fit: contain;
      border-radius: 15px;
      border: 1px solid var(--border);
      padding: 5px;
      background: white;
    }

    .education-card h3 { margin: 0 0 8px; font-size: 20px; }
    .education-card p { margin: 5px 0; color: var(--muted); font-size: 14px; }

    .activities {
      margin-top: 16px;
      padding-top: 15px;
      border-top: 1px solid var(--border);
    }

    .activities strong { font-size: 13px; }

    .project-grid {
      display: grid;
      grid-template-columns: 1.25fr 1fr 1fr;
      gap: 17px;
    }

    .project-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 23px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform .2s, box-shadow .2s;
    }

    .project-feature {
      background: linear-gradient(145deg, #f48bb5, #fbd7e5);
      padding: 25px;
    }

    .project-feature .tag {
      display: inline-block;
      padding: 5px 10px;
      border-radius: 20px;
      background: var(--deep-pink);
      color: white;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .7px;
    }

    .project-feature h3 {
      font-size: 35px;
      margin: 18px 0 4px;
      letter-spacing: -2px;
    }

    .project-feature .project-subtitle {
      font-weight: 700;
      font-size: 14px;
    }

    .project-feature p {
      font-size: 13px;
      line-height: 1.65;
    }

    .project-content {
      padding: 24px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .project-content h3 { font-size: 20px; margin: 13px 0 8px; }
    .project-content p { color: var(--muted); font-size: 13px; margin: 0 0 18px; }

    .project-link {
      margin-top: auto;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
    }

    .project-link:hover { text-decoration: underline; }

    .tag-list {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin: 14px 0 20px;
    }

    .tag-list span {
      font-size: 10px;
      background: var(--light-pink);
      color: var(--deep-pink);
      border-radius: 20px;
      padding: 5px 9px;
      font-weight: 700;
    }

    .contact {
      margin: 75px 0 35px;
      padding: 30px;
      background: #fbe2ec;
      border: 1px solid var(--border);
      border-radius: 25px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .contact h2 { font-size: 27px; }
    .contact p { color: var(--muted); font-size: 14px; }

    footer {
      padding: 25px 0 35px;
      text-align: center;
      color: var(--muted);
      font-size: 12px;
    }

    @media (max-width: 850px) {
      .hero { grid-template-columns: 1fr; padding-top: 40px; }
      .portrait-area { min-height: 240px; max-width: 450px; width: 100%; margin: auto; }
      .portrait-initials { width: 145px; height: 145px; font-size: 60px; }
      .skills-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .project-grid { grid-template-columns: 1fr 1fr; }
      .project-card:first-child { grid-column: 1 / -1; }
      .info-strip { grid-template-columns: 1fr; }
    }

    @media (max-width: 520px) {
      .container { width: 91%; }
      nav { align-items: flex-start; }
      .nav-links { gap: 12px; justify-content: flex-end; }
      .nav-links a { font-size: 12px; }
      nav > .button { display: none; }
      h1 { letter-spacing: -2px; }
      .section-block { padding-top: 55px; }
      .section-heading { align-items: flex-start; flex-direction: column; }
      .project-grid { grid-template-columns: 1fr; }
      .project-card:first-child { grid-column: auto; }
      .education-card { padding: 20px; gap: 13px; }
      .school-logo { width: 55px; height: 55px; }
      .contact { align-items: flex-start; flex-direction: column; }
    }
  </style>
</head>

